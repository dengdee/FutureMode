# Backend-only local settings
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Required for multi-instance Vercel WebSocket fan-out and shared presence.
UPSTASH_REDIS_URL=rediss://default:<token>@<host>:6379
REALTIME_REQUIRE_BROKER=false
MEETING_BAAS_API_KEY=
MEETING_BAAS_URL=https://api.meetingbaas.com/v2/bots
MEETING_BAAS_INPUT_URL=
MEETING_BAAS_WEBHOOK_SECRET=
# Gemini embeddings use the same free-tier key as the preparation assistant.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CHUNKS=500
LLM_PROVIDER=gemini
# Gemini free-tier key; alternatively set LLM_API_KEY.
LLM_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=30
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRESIGNED_EXPIRY_SECONDS=600
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
NEON_AUTH_ISSUER=https://your-neon-auth-issuer.example.com
NEON_AUTH_BASE_URL=https://your-neon-auth-issuer.example.com
NEON_AUTH_SESSION_URL=https://your-neon-auth-issuer.example.com/api/auth/get-session
NEON_AUTH_AUDIENCE=your-neon-auth-audience
NEON_AUTH_JWKS_URL=https://your-neon-auth-issuer.example.com/.well-known/jwks.json
